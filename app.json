{
  "expo": {
    "name": "DuaSaku — Keuangan Pasangan",
    "slug": "duasaku",
    "version": "1.0.0",
    "versionCode": 1,
    "scheme": "duasaku",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "plugins": [
      "./plugins/withCleartextTraffic.js",
      "./plugins/withAppShortcuts.js",
      "expo-build-properties"
    ],
    "android": {
      "package": "com.duasaku.couplefinance",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF6F0"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "extra": {
      "apiUrl": "https://duasaku-api.vercel.app",
      "eas": {
        "projectId": "56fde718-5f8b-43a9-99d6-83caf98037c7"
      }
    },
    "owner": "beitro",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
