{
  "expo": {
    "name": "DuaSaku — Keuangan Pasangan",
    "slug": "duasaku",
    "version": "1.0.0",
    "versionCode": 1,
    "scheme": "duasaku",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "./plugins/withCleartextTraffic.js",
      "./plugins/withAppShortcuts.js",
      "expo-build-properties"
    ],
    "android": {
      "package": "com.duasaku.couplefinance",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF6F0"
      },
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE"],

    },
    "extra": {
      "apiUrl": "https://duasaku-api.vercel.app"
    },
    "owner": "beitro",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
